{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=2048&& next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pages:build": "vercel build && npx @cloudflare/next-on-pages --skip-build",
    "preview": "wrangler pages dev .vercel/output/static --compatibility-flag nodejs_compat",
    "deploy": "wrangler pages deploy .vercel/output/static --project-name synapse"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.104.1",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.16.0",
    "next": "^15.5.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.84.1"
  },
  "devDependencies": {
    "@serwist/next": "^9.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.2",
    "serwist": "^9.5.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^47.0.4"
  }
}
